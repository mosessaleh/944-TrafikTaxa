generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum Role {
  USER
  ADMIN
}

enum RideStatus {
  PENDING
  PAID
  PROGRESSING
  CONFIRMED
  DISPATCHED
  ONGOING
  PICKED_UP
  DELIVERED
  COMPLETED
  CANCELED
  REFUNDING
  REFUNDED
}

enum VehicleKey {
  SEDAN5
  SEVEN_NO_BAG
  VAN
  LIMO
  // Allow dynamic keys for new vehicle types
}

enum Sex {
  MALE
  FEMALE
}

// =====================
// Models
// =====================

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  hashedPassword      String
  firstName           String
  lastName            String
  phone               String
  address             String
  role                Role      @default(USER)
  language            String    @default("dk")
  emailVerified       Boolean   @default(false)
  emailVerifyCode     String?
  emailVerifyExpires  DateTime?
  pendingEmail        String?
  pendingEmailCode    String?
  pendingEmailExpires DateTime?
  resetToken          String?
  resetExpires        DateTime?
  createdAt           DateTime  @default(now())
  canPayByInvoice     Boolean   @default(false)
  stripeCustomerId    String?   @unique // Stripe customer ID for payment processing
  pushToken           String?   @unique // Expo push token for notifications

  rides        Ride[]
  favorites    favoriteaddress[]
  complaints   Complaint[]
  invoices     Invoice[]
  notifications Notification[]
  notificationSettings NotificationSettings?
  paymentMethods UserPaymentMethod[]

  // Optimized indexes for common queries
  @@index([role])
  @@index([emailVerified])
  @@index([canPayByInvoice])
  @@index([role, emailVerified])          // For admin queries
  @@index([createdAt])                     // For user listing
  @@index([emailVerified, canPayByInvoice]) // For user access queries
}

model UserPaymentMethod {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  type        String   // 'card', 'paypal', 'revolut'
  provider    String   // 'stripe', 'paypal', 'revolut'
  token       String   // Encrypted payment token
  last4       String?  // Last 4 digits for cards
  expiryMonth Int?
  expiryYear  Int?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rides Ride[]

  @@index([userId, isActive])
  @@index([userId, isDefault])
}

model VehicleType {
  id         Int        @id @default(autoincrement())
  key        String     @unique
  title      String
  capacity   Int        @default(4)
  active     Boolean    @default(true)
  // multiplier يضاعف السعر الأساسي (حسب قواعد النهار/الليل)
  multiplier Float      @default(1.0)
  note       String?

  rides Ride[]
}

model favoriteaddress {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  label     String
  address             String    @default("")
  lat       Float?
  lon       Float?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Settings {
  id           Int     @id @default(1)
  // Company info
  brandName    String? @default("944 Trafik")
  contactEmail String? @default("trafik@944.dk")
  contactPhone String? @default("26444944")
  addressCity  String? @default("Frederikssund")
  // Day (06:00–18:00)
  dayBase      Float   @default(40)
  dayPerKm     Float   @default(12.75)
  dayPerMin    Float   @default(5.75)
  // Night & Holidays
  nightBase    Float   @default(60)
  nightPerKm   Float   @default(16)
  nightPerMin  Float   @default(7)
  // Business hours
  workStart    String  @default("06:00")
  workEnd      String  @default("18:00")
  // Cancellation fees (as percentages)
  scheduledCancellationFee1 Float @default(0)    // More than 2 hours before: no fee (0%)
  scheduledCancellationFee2 Float @default(25)   // 1-2 hours before: up to 25%
  scheduledCancellationFee3 Float @default(50)   // Less than 1 hour before: up to 50%
  immediateCancellationFee  Float @default(50)   // Fixed fee for immediate rides (DKK)
  // Global discounts
  discountPercentage      Float @default(0)    // Percentage discount applied to all bookings
  maxDiscountAmount       Float @default(0)    // Maximum discount amount per booking
}

model Ride {
  id             Int        @id @default(autoincrement())
  user           User       @relation(fields: [userId], references: [id])
  userId         Int
  riderName      String
  passengers     Int        @default(1)
  pickupAddress  String
  dropoffAddress String
  startLatLon    Json?      // [lat, lon] for pickup coordinates
  endLatLon      Json?      // [lat, lon] for dropoff coordinates
  droppedOnLocation Json?   // [lat, lon] for actual dropoff location
  scheduled      Boolean    @default(false)
  pickupTime     DateTime
  distanceKm     Float?
  durationMin    Int?
  price          Int
  status         String     @default("PENDING")
  explanation    String     @default("Waiting for payment")
  paymentStatus  String     @default("UNPAID")
  driverId       Int?
  car            String?
  createdAt      DateTime   @default(now())
  acceptedAt     DateTime?
  pickedAt       DateTime?
  droppedAt      DateTime?
  paymentMethod  String?
  savedPaymentMethodId Int?

  // Payment reference for external payment processors (Stripe Payment Intent ID, etc.)
  paymentRef     String?

  // Payment Processing Fields
  paymentRetryCount    Int?         @default(0)    // Number of payment retry attempts
  paymentNextRetry     DateTime?                   // Next scheduled retry time
  paymentLastAttempt   DateTime?                   // Last payment attempt timestamp
  paymentFailureReason String?                     // Reason for last payment failure

  // Risk Management Fields
  riskScore      Float?     @default(0) // 0-100 risk score
  riskLevel      String?    @default("low") // low, medium, high, critical
  riskFactors    Json?      @default("[]") // Array of risk factors detected
  riskReviewed   Boolean    @default(false) // Whether admin has reviewed
  riskApproved   Boolean?   // Admin approval status
  riskNotes      String?    // Admin notes about risk assessment
  driverQueue    Json?      @default("[]") // Array of top 3 vehicle IDs prioritized for assignment

  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  vehicleTypeId Int

  complaints Complaint[]
  invoices   Invoice[]
  savedPaymentMethod UserPaymentMethod? @relation(fields: [savedPaymentMethodId], references: [id])

  // Optimized indexes for common queries
  @@index([userId])
  @@index([vehicleTypeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pickupTime])
  @@index([createdAt])
  @@index([savedPaymentMethodId])
  @@index([paymentRef])
  @@index([riskScore])
  @@index([riskLevel])
  @@index([riskReviewed])
  @@index([userId, status])                    // For user ride filtering
  @@index([userId, createdAt])                 // For user history
  @@index([status, pickupTime])                // For admin dashboard queries
  @@index([vehicleTypeId, status])             // For vehicle type filtering
  @@index([paymentStatus, status])             // For payment status filtering
  @@index([scheduled, pickupTime])             // For scheduled rides
  @@index([status, paymentStatus])             // For comprehensive status filtering
  @@index([riskLevel, riskReviewed])           // For risk management filtering
  @@index([createdAt, riskScore])              // For risk analytics
}


// === Added by assistant (crypto payments) ===
model CryptoWallet {
  id        String   @id @default(cuid())
  symbol    String   // 'usdt' | 'usdc' | 'btc' | 'pi'
  network   String   // e.g., TRC20, ERC20, BTC
  address   String
  isActive  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime?

  @@index([symbol, isActive])
}

model CryptoPayment {
  id         String   @id @default(cuid())
  userId     String?
  symbol     String
  network    String
  addressId  String?
  address    String
  amountDkk  Float
  amountCoin Float
  status     String   @default("pending") // pending, confirmed, rejected
  createdAt  DateTime @default(now())
}


// === Added by assistant (card payments) ===
model CardPayment {
  id        String   @id @default(cuid())
  userId    String?
  amountDkk Float
  status    String   @default("paid") // paid, refunded, failed
  createdAt DateTime @default(now())
}

// === Added by assistant (PayPal payments) ===
model PayPalPayment {
  id            String   @id @default(cuid())
  userId        String?
  amountDkk     Float
  status        String   @default("paid") // paid, refunded, failed
  paypalOrderId String
  createdAt     DateTime @default(now())
}

// === Added by assistant (Revolut payments) ===
model RevolutPayment {
  id         String   @id @default(cuid())
  userId     String?
  amountDkk  Float
  status     String   @default("paid") // paid, refunded, failed
  paymentId  String
  createdAt  DateTime @default(now())
}

// === Added by assistant (Payment Methods) ===
model PaymentMethod {
  id                Int      @id @default(autoincrement())
  key               String   @unique // 'card', 'crypto', 'paypal', 'revolut', 'invoice'
  title             String
  description       String?
  isActive          Boolean  @default(true)
  // Development mode settings
  devPublicKey      String?
  devSecretKey      String?
  devWebhookSecret  String?
  // Production mode settings
  prodPublicKey     String?
  prodSecretKey     String?
  prodWebhookSecret String?
  // Additional settings for different payment providers
  devClientId       String? // For PayPal, Revolut
  prodClientId      String? // For PayPal, Revolut
  devApiUrl         String? // For Revolut
  prodApiUrl        String? // For Revolut
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// === Added by assistant (Audit Logging) ===
model AuditLog {
  id        Int      @id @default(autoincrement())
  event     String
  userId    String?
  ipAddress String?
  userAgent String?
  metadata  Json     @default("{}")
  severity  String   @default("low") // low, medium, high, critical
  timestamp DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([ipAddress])
  @@index([timestamp])
  @@index([severity])
}

// === Added by assistant (Complaints System) ===
model Complaint {
  id              Int      @id @default(autoincrement())
  userId          Int
  rideId          Int
  complaint       Json     // Changed to Json to store array of conversation messages
  status          String   @default("OPEN") // OPEN, CLOSED, ACCEPTED
  adminDecision   String?
  category        String?  @default("other") // delay, driver, pricing, technical, other
  priority        String   @default("medium") // high, medium, low
  slaDeadline     DateTime? // SLA response deadline
  escalated       Boolean  @default(false) // Whether complaint has been escalated
  responseTemplate String? // ID of automated response template used
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  ride Ride @relation(fields: [rideId], references: [id])

  // Optimized indexes for complaint queries
  @@index([userId])
  @@index([rideId])
  @@index([status])
  @@index([createdAt])
  @@index([adminDecision])
  @@index([category])
  @@index([priority])
  @@index([escalated])
  @@index([slaDeadline])
  @@index([userId, status])                // For user complaint filtering
  @@index([status, createdAt])             // For admin complaint listing
  @@index([createdAt, status])             // For complaint reporting
  @@index([category, priority])            // For categorization and priority filtering
  @@index([status, escalated])             // For escalation tracking
  @@index([slaDeadline, status])           // For SLA monitoring
}

// === Invoice Model ===
model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  userId        Int
  rideId        Int
  dueDate       DateTime
  paymentStatus String   @default("UNPAID") // UNPAID, PAID, OVERDUE
  status        Int      @default(1) // 1 = active, 0 = cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime?

  // === New fields for payment receipt tracking ===
  paymentMethod   String?      // 'card', 'crypto', 'paypal', 'revolut', 'cash', 'admin_confirmed'
  paymentRef      String?      // Payment reference number (transaction ID, admin ID, etc.)
  paymentDate     DateTime?    // Date when payment was received
  paymentAmount   Float?       // Actual payment amount received
  paymentNotes    String?      // Additional notes about the payment
  confirmedBy     Int?         // Admin ID who confirmed the payment
  confirmedAt     DateTime?    // When the payment was confirmed by admin
  receiptNumber   String?      // Generated receipt number

  // === Late fee fields ===
  lateFee1        Float?       // First late fee amount (100 DKK + 5.7% of invoice amount)
  lateFee2        Float?       // Second late fee amount (if applicable)
  lateFee1Date    DateTime?    // When the first late fee was applied
  lateFee2Date    DateTime?    // When the second late fee was applied
  extendedDueDate DateTime?    // Extended due date after late fee application

  @@map("invoice")

  ride Ride @relation(fields: [rideId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // Optimized indexes for invoice queries
  @@index([userId])
  @@index([rideId])
  @@index([paymentStatus])
  @@index([status])
  @@index([dueDate])
  @@index([userId, paymentStatus])           // For user invoice filtering
  @@index([userId, status])                  // For user active invoices
  @@index([paymentStatus, dueDate])          // For overdue invoice queries
  @@index([status, paymentStatus])           // For comprehensive status filtering
  @@index([createdAt, paymentStatus])        // For invoice history and reporting
  
  // New indexes for payment receipt tracking
  @@index([paymentMethod])
  @@index([paymentRef])
  @@index([paymentDate])
  @@index([confirmedBy])
  @@index([receiptNumber])
  @@index([paymentStatus, paymentDate])      // For payment date filtering
  @@index([confirmedBy, confirmedAt])        // For admin confirmation tracking
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      String   // e.g. booking_confirmed, payment_received, invoice_ready
  title     String
  body      String
  data      Json?    @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model NotificationSettings {
  id             Int   @id @default(autoincrement())
  user           User  @relation(fields: [userId], references: [id])
  userId         Int   @unique
  emailBooking   Boolean @default(true)
  emailPayment   Boolean @default(true)
  emailInvoice   Boolean @default(true)
  emailMarketing Boolean @default(false)
}

model PartnerCompany {
  id             Int      @id @default(autoincrement())
  cvr            String?  @unique
  comName        String
  contactPerson  String
  comAddress     String
  comPhone       String
  comEmail       String?
  comBankInfo    String?
  comStatus      Boolean  @default(false)
  commissionRate Float    @default(0.0)
  contractSigned Boolean  @default(false)
  comUserName    String   @unique
  comPass        String   // Will store hashed password
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drivers  comDriver[]
  vehicles comVehicles[]

  @@index([comStatus])
  @@index([contractSigned])
  @@index([createdAt])
}

model comDriver {
  id             Int         @id @default(autoincrement())
  comId          Int
  cpr            String      // ENCRYPTED: Danish CPR number (Personal Identification Number)
  drFname        String
  drLname        String
  sex            Sex
  drAddress      String
  drPhone        String
  drEmail        String?
  drPhoto        String?
  licenceNr      String
  drCard         String
  rating         Decimal     @default(5.00) @db.Decimal(3, 2)
  isOnline       Boolean     @default(false)
  isActive       Boolean     @default(true)
  isBusy         Boolean     @default(false)
  busyMode       String?     // 'manual' or 'auto' - reason for busy status
  bannedUntil    DateTime?   // Time until driver is banned from receiving rides
  car            String?     // Car ID or license plate
  currentRideId  Int?
  rideAccepted   Int         @default(0) // Number of rides accepted by this driver
  drUsername     String      @unique
  drPass         String      // Will store hashed password
  resetToken     String?     // Password reset token
  resetExpires   DateTime?   // Password reset token expiry
  apiKey         String?     @unique // API key for server-to-server calls
  expoPushToken  String?     @unique // Expo push token for notifications
  lastLocation   Json?       // {lat: float, lon: float}
  penaltyUntil   DateTime?   // Penalty until this time
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  company PartnerCompany @relation(fields: [comId], references: [id])
  shifts   driversvagt[]

  @@index([comId])
  @@index([isOnline])
  @@index([currentRideId])
  @@index([apiKey])
  @@index([penaltyUntil])
}

model comVehicles {
  id               Int      @id @default(autoincrement())
  comId            Int
  uId              Int?
  vehicleType      String?
  regNumber        String
  make             String
  model            String
  variant          String?
  year             Int?
  vinNumber        String?
  seats            Int?
  color            String?
  fuel             String?
  status           Int      @default(0)
  taxiPermitNumber String?
  notes            String?
  // Location tracking fields
  lastLat           Float?
  lastLon           Float?
  lastLocationUpdate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company PartnerCompany @relation(fields: [comId], references: [id])

  @@index([comId])
  @@index([uId])
  @@index([status])
}

model driversvagt {
  id        Int      @id @default(autoincrement())
  drId      Int
  startVagt DateTime?  // Start time
  endVagt   DateTime?  // End time
  workTime  Float?
  date      DateTime
  salary    Decimal  @db.Decimal(10, 2) // Salary with 2 decimal places
  hourSalary Decimal @db.Decimal(10, 2) // Hourly salary with 2 decimal places
  startKM   Int
  endKM     Int
  deffKM    Int

  driver comDriver @relation(fields: [drId], references: [id])

  @@index([drId])
  @@index([date])
}

