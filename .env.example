# =====================================
# 944 Trafik Taxi Service - Environment Variables
# =====================================

# Application Settings
AUTH_SECRET=change-me-to-a-secure-random-string
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=

# Database Configuration
DATABASE_URL=mysql://taxiuser:taxipass@localhost:3306/944_taxi

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
FROM_EMAIL=944 Trafik <no-reply@944.dk>

# Email Service (Resend - Alternative to SMTP)
RESEND_API_KEY=
RESEND_FROM=944 Trafik <no-reply@944.dk>

# Admin Token (for admin actions)
ADMIN_TOKEN=admin-seed-2024

# CPR Data Encryption (REQUIRED for security compliance)
CPR_ENCRYPTION_KEY=your-very-secure-encryption-key-here-32-chars-minimum

# Stripe Payment Configuration (Optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Cryptocurrency Payment APIs (Optional)
NOWNODES_API_KEY=

# Email Service Provider Selection
# SMTP_RESEND=true  # Set to true to use Resend instead of SMTP

# Development/Production Mode
# NODE_ENV=development

# Optional: Custom Logo URL
# CUSTOM_LOGO_URL=/logo.svg

# Optional: Company Information
# COMPANY_NAME=944 Trafik
# COMPANY_PHONE=+45 26444944
# COMPANY_EMAIL=trafik@944.dk
# COMPANY_ADDRESS=3600 Frederikssund, Denmark

# Driver API Origins (for production)
# ALLOWED_DRIVER_ORIGINS=https://drivers.company.com,https://api.drivers.com


ALLOWED_DRIVER_ORIGINS=